# --- Aplicação e Segurança ---
PROJECT_NAME="Agendha System"
API_V1_STR="/api/v1"
SECRET_KEY="substitua_por_uma_chave_secreta_forte_gerada_com_secrets_token_hex_32"
ALGORITHM="HS256"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="sua_senha_forte_admin"

# --- Supabase (PostgreSQL & Storage) ---
SUPABASE_URL="https://sua-instancia.supabase.co"
SUPABASE_KEY="sua_supabase_anon_ou_service_role_key"
SUPABASE_DB_STRING="postgresql://postgres.sua-instancia:sua_senha_banco@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# --- Google Gemini AI (Visão Computacional & OCR) ---
GEMINI_API_KEY="AIzaSy_sua_chave_gemini_api_key"

# --- Coletum API (v2) ---
COLETUM_TOKEN="seu_token_api_coletum"

# --- Armazenamento Local de Arquivos dos Técnicos (Opcional / Desktop) ---
LOCAL_STORAGE_BASE_PATH=""

